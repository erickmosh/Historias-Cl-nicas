/** Autoguardado: dos segundos después de la última tecla. */
let temporizadorGuardado = null;

function engancharEditores() {
  const editor = $('[data-editor]');
  if (!editor) return;
  const id = editor.dataset.editor;
  $$('input, textarea, select', editor).forEach((el) => {
    el.addEventListener('input', () => {
      marcarSucio();
      clearTimeout(temporizadorGuardado);
      temporizadorGuardado = setTimeout(() => guardarConsulta(id, true), 2000);
    });
  });
}

function marcarSucio() {
  const caja = $('#estado-guardado');
  if (caja) caja.innerHTML = '<span class="punto sucio"></span> Cambios sin guardar';
}

async function guardarConsulta(id, silencioso) {
  clearTimeout(temporizadorGuardado);
  const c = buscarId('consultas', id);
  if (!c || !$('#c-notas')) return;

  const escala = $('#c-escalaAnimo').value;
  const datos = {
    fechaHora: $('#c-fechaHora').value ? new Date($('#c-fechaHora').value).toISOString() : c.fechaHora,
    duracionMin: Number($('#c-duracionMin').value) || 50,
    modalidad: $('#c-modalidad').value,
    motivo: $('#c-motivo').value.trim() || null,
    notas: $('#c-notas').value,
    observaciones: $('#c-observaciones').value.trim() || null,
    estadoEmocional: $('#c-estadoEmocional').value.trim() || null,
    escalaAnimo: escala === '' ? null : Math.min(10, Math.max(1, Number(escala))),
    proximaCita: $('#c-proximaCita').value ? new Date($('#c-proximaCita').value).toISOString() : null,
  };

  const antes = { ...c };
  Object.assign(c, datos, { editadoPorId: sesion.usuario.id });
  await guardar('consultas', c);
  await auditar('Consulta', c.id, antes, datos);

  // La ficha muestra la fecha de la última sesión: se mantiene al día
  const p = buscarId('pacientes', c.pacienteId);
  const ultima = porPaciente('consultas', p.id).map((x) => x.fechaHora).sort().pop() || null;
  if (p.fechaUltimaSesion !== ultima) { p.fechaUltimaSesion = ultima; await guardar('pacientes', p); }

  const caja = $('#estado-guardado');
  if (caja) caja.innerHTML = '<span class="punto"></span> Guardado';
  if (!silencioso) nota('Consulta guardada.');
}

