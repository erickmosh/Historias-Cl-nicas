  document.body.appendChild(velo);
  document.body.style.overflow = 'hidden';

  const alTeclado = (e) => { if (e.key === 'Escape') cerrarModal(); };
  document.addEventListener('keydown', alTeclado);
  velo.addEventListener('mousedown', (e) => { if (e.target === velo) cerrarModal(); });
  velo.querySelector('[data-cerrar]').addEventListener('click', cerrarModal);

  cerrarModalActual = () => {
    document.removeEventListener('keydown', alTeclado);
    velo.remove();
    document.body.style.overflow = '';
    cerrarModalActual = null;
  };
  alAbrir?.(velo);
  velo.querySelector('input,textarea,select,button.btn')?.focus();
  return velo;
}

function cerrarModal() { cerrarModalActual?.(); }

