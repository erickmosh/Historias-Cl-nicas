async function guardarPaciente(e, existente) {
  e.preventDefault();
  const leer = (c) => $('#p-' + c)?.value.trim() ?? '';
  const documento = leer('documento');
  const repetido = BD.pacientes.find((p) => p.documento === documento && p.id !== existente?.id);
  if (repetido) {
    $('#paciente-error').innerHTML =
      `<div class="aviso granate">Ya hay una ficha con ese documento: ${esc(repetido.nombreCompleto)}.</div>`;
    return;
  }

  const datos = {};
  for (const [, campos] of CAMPOS_PACIENTE) {
    for (const [id] of campos) datos[id] = leer(id) || null;
  }
  datos.fechaNacimiento = $('#p-fechaNacimiento').value || null;
  datos.estado = $('#p-estado').value;

  if (existente) {
    const antes = { ...existente };
    Object.assign(existente, datos);
    await guardar('pacientes', existente);
    await auditar('Paciente', existente.id, antes, datos);
  } else {
    await guardar('pacientes', {
      id: uid(), ...datos, archivado: false,
      terapeutaId: sesion.usuario.id,
      fechaPrimerIngreso: new Date().toISOString(), fechaUltimaSesion: null,
      permiso: { aceptado: false, estado: 'PENDIENTE', firmaNombre: null, fechaFirma: null, texto: '', version: 'v1' },
      creadoEn: new Date().toISOString(),
    });
  }
  cerrarModal();
  render();
  nota(existente ? 'Ficha actualizada.' : 'Ficha creada.');
}

