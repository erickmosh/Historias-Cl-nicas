      ${campo({ etiqueta: 'Título', clase: 'ancho', control: entrada('ta-titulo', t?.titulo || '', 'required placeholder="Registro de pensamientos automáticos"') })}
      ${campo({
        etiqueta: 'Descripción', clase: 'ancho',
        control: area('ta-descripcion', t?.descripcion || '', 3, 'placeholder="Qué tiene que hacer, con qué frecuencia y en qué momento."'),
      })}
      ${campo({ etiqueta: 'Fecha límite', control: entrada('ta-limite', paraInput(t?.fechaLimite), 'type="date"') })}
      ${campo({ etiqueta: 'Estado', control: selector('ta-estado', ESTADOS_TAREA, t?.estado || 'PENDIENTE') })}
      ${campo({ etiqueta: 'Tratamiento asociado', clase: 'ancho', control: selector('ta-tratamiento', tratamientos, t?.tratamientoId || '', 'Sin asociar') })}
      ${t ? campo({ etiqueta: 'Comentario del paciente', clase: 'ancho', control: area('ta-comentario', t.comentarioPaciente || '', 2) }) : ''}
      ${t ? campo({ etiqueta: 'Retroalimentación del terapeuta', clase: 'ancho', control: area('ta-feedback', t.feedbackTerapeuta || '', 2) }) : ''}
    </form>`,
    pie: `${boton('Cancelar', 'cerrar-modal', { clase: 'sec' })}
          <button class="btn" type="submit" form="form-tarea">Guardar</button>`,
    alAbrir: (velo) => $('#form-tarea', velo).addEventListener('submit', async (e) => {
      e.preventDefault();
      const datos = {
        titulo: $('#ta-titulo').value.trim(),
        descripcion: $('#ta-descripcion').value.trim() || null,
        fechaLimite: $('#ta-limite').value || null,
        estado: $('#ta-estado').value,
        tratamientoId: $('#ta-tratamiento').value || null,
        comentarioPaciente: $('#ta-comentario')?.value.trim() || t?.comentarioPaciente || null,
        feedbackTerapeuta: $('#ta-feedback')?.value.trim() || t?.feedbackTerapeuta || null,
      };
      if (t) {
        const antes = { ...t };
        Object.assign(t, datos);
        await guardar('tareas', t);
        await auditar('Tarea', t.id, antes, datos);
      } else {
        await guardar('tareas', {
          id: uid(), pacienteId: p.id, consultaId: null, ...datos,
          fechaAsignacion: new Date().toISOString(), creadoEn: new Date().toISOString(),
        });
      }
      cerrarModal();
      render();
    }),
  });
}

// --- Pestaña: Evolución -----------------------------------------------------

function pestanaEvolucion(p) {
  const consultas = porPaciente('consultas', p.id);
  const tratamientos = porPaciente('tratamientos', p.id);
  const tareas = porPaciente('tareas', p.id);
  const reportes = porPaciente('reportes', p.id);

  const eventos = [
    ...consultas.map((c) => ({
      tipo: 'consulta', cuando: c.fechaHora, titulo: `Sesión ${c.numeroSesion}`,
      detalle: c.motivo || c.estadoEmocional || '',
    })),
    ...tratamientos.map((t) => ({
      tipo: 'tratamiento', cuando: t.fechaInicio,
      titulo: `Inicio de tratamiento: ${t.nombre}`, detalle: t.enfoque || '',
    })),
    ...tratamientos.filter((t) => t.fechaCierre).map((t) => ({
      tipo: 'tratamiento', cuando: t.fechaCierre,
      titulo: `Cierre de tratamiento: ${t.nombre}`, detalle: et(t.estado),
    })),
    ...tareas.filter((t) => t.estado === 'COMPLETADA').map((t) => ({
      tipo: 'tarea', cuando: t.actualizadoEn || t.fechaAsignacion,
      titulo: `Tarea completada: ${t.titulo}`, detalle: t.comentarioPaciente || '',
    })),
    ...reportes.map((r) => ({
      tipo: 'reporte', cuando: r.creadoEn, titulo: r.titulo,
      detalle: 'Generado por ' + (usuario(r.generadoPorId)?.nombre || '—'),
    })),
  ].sort((a, b) => new Date(b.cuando) - new Date(a.cuando));

  if (!eventos.length) {
    return vacioEstado('Todavía no hay evolución que mostrar',
      'La línea de tiempo se construye con las consultas, los tratamientos y las tareas completadas.');
  }

  const colores = { consulta: 'var(--verde)', tratamiento: 'var(--ambar)', tarea: 'var(--tinta)', reporte: 'var(--apagado)' };
  const serie = consultas
    .filter((c) => typeof c.escalaAnimo === 'number')
    .sort((a, b) => new Date(a.fechaHora) - new Date(b.fechaHora));

  return `
  <div class="rejilla" style="grid-template-columns:1fr">
    <div class="rejilla c2" style="align-items:start">
      <div class="tarjeta p5">
        <h2 class="mb4">Línea de tiempo</h2>
        <ol class="tiempo">
          ${eventos.map((e) => `
            <li>
              <span class="bolita" style="background:${colores[e.tipo]}"></span>
              <p class="f">${fecha(e.cuando)}</p>
              <p style="font-weight:500">${esc(e.titulo)}</p>
              ${e.detalle ? `<p class="d">${esc(e.detalle)}</p>` : ''}
            </li>`).join('')}
        </ol>
      </div>
      <div class="tarjeta p5">
        <h2>Escala de ánimo</h2>
        <p class="pequeno apagado mb4">Valor autoinformado al cierre de cada sesión (1–10).</p>
        ${serie.length < 2
          ? '<p class="apagado" style="font-size:13px">Hacen falta al menos dos sesiones con escala registrada.</p>'
          : graficoAnimo(serie)}
      </div>
    </div>
  </div>`;
}

/** Gráfico de líneas en SVG. Una serie corta no necesita una librería. */
function graficoAnimo(serie) {
  const w = 300, h = 150, pad = 26;
  const puntos = serie.map((c, i) => {
    const x = pad + (i * (w - pad * 2)) / Math.max(1, serie.length - 1);
    const y = h - pad - ((c.escalaAnimo - 1) / 9) * (h - pad * 2);
    return { x, y, c };
  });
  const guias = [1, 5, 10].map((v) => {
    const y = h - pad - ((v - 1) / 9) * (h - pad * 2);
    return `<line x1="${pad}" y1="${y}" x2="${w - pad}" y2="${y}" stroke="var(--borde)"/>
            <text x="${pad - 6}" y="${y + 3}" text-anchor="end" font-size="9" fill="var(--apagado)">${v}</text>`;
  }).join('');
  return `<svg viewBox="0 0 ${w} ${h}" style="width:100%" role="img"
    aria-label="Evolución del ánimo en ${serie.length} sesiones">
    ${guias}
    <polyline points="${puntos.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ')}"
      fill="none" stroke="var(--verde)" stroke-width="2"/>
    ${puntos.map((p) => `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3" fill="var(--verde)">
      <title>Sesión ${p.c.numeroSesion}: ${p.c.escalaAnimo}/10</title></circle>`).join('')}
  </svg>`;
}
// ---------------------------------------------------------------------------
// 7. Reportes en PDF
//
// jsPDF compone el documento en el propio navegador. No hay servidor, así que
// tampoco hay nada que instalar; a cambio, la maquetación se calcula a mano
// con un cursor vertical en lugar de dejársela a un motor HTML.
// ---------------------------------------------------------------------------

const TITULOS_REPORTE = {
  COMPLETO: 'Reporte completo del paciente',
  SESIONES: 'Reporte de sesiones por rango de fechas',
  EVOLUCION: 'Reporte de evolución clínica',
  TAREAS: 'Reporte de tareas asignadas',
  TRATAMIENTOS: 'Reporte de tratamientos',
};

const TINTA = [23, 33, 43];
const VERDE = [47, 111, 98];
const APAGADO = [85, 99, 95];
const BORDE = [221, 228, 226];

const hayJsPdf = () => !!(window.jspdf && window.jspdf.jsPDF);

/** Cursor de escritura sobre el documento, con salto de página automático. */
class Lienzo {
  constructor(doc) {
    this.doc = doc;
    this.ancho = doc.internal.pageSize.getWidth();
    this.alto = doc.internal.pageSize.getHeight();
    this.izq = 16;
    this.der = this.ancho - 16;
    this.arriba = 26;
    this.abajo = this.alto - 22;
    this.y = this.arriba;
  }

  get util() { return this.der - this.izq; }

  espacio(mm) {
    if (this.y + mm > this.abajo) this.nuevaPagina();
  }

  nuevaPagina() {
    this.doc.addPage();
    this.y = this.arriba;
  }

  salto(mm = 4) { this.y += mm; }

  titulo(texto) {
    this.espacio(14);
    this.doc.setFont('helvetica', 'bold').setFontSize(12).setTextColor(...VERDE);
    this.doc.text(texto, this.izq, this.y);
    this.y += 2.5;
    this.doc.setDrawColor(...VERDE).setLineWidth(0.5);
    this.doc.line(this.izq, this.y, this.der, this.y);
    this.y += 6;
  }

  subtitulo(texto) {
    this.espacio(10);
    this.doc.setFont('helvetica', 'bold').setFontSize(10).setTextColor(...TINTA);
    this.doc.text(texto, this.izq, this.y);
    this.y += 5;
  }

  parrafo(texto, { tam = 9.5, color = TINTA, estilo = 'normal', sangria = 0 } = {}) {
    if (!texto) return;
    this.doc.setFont('helvetica', estilo).setFontSize(tam).setTextColor(...color);
    const lineas = this.doc.splitTextToSize(String(texto), this.util - sangria);
    const alturaLinea = tam * 0.48;
    for (const linea of lineas) {
      this.espacio(alturaLinea + 1);
      this.doc.text(linea, this.izq + sangria, this.y);
      this.y += alturaLinea;
    }
    this.y += 1.5;
  }

  /** Notas en markdown ligero: listas con guion y párrafos. */
  notas(texto) {
    if (!texto || !texto.trim()) {
      this.parrafo('Sin contenido', { color: APAGADO, estilo: 'italic' });
      return;
    }
    for (const linea of texto.split('\n')) {
      const item = linea.match(/^\s*[-*]\s+(.*)$/);
      const limpio = (item ? item[1] : linea).replace(/\*+/g, '');
      if (!limpio.trim()) continue;
      if (item) {
        this.espacio(5);
        this.doc.setFillColor(...APAGADO);
        this.doc.circle(this.izq + 1.6, this.y - 1.2, 0.6, 'F');
        this.parrafo(limpio, { sangria: 5 });
      } else {
        this.parrafo(limpio);
      }
    }
  }

  /** Pares etiqueta/valor en dos columnas. */
  datos(pares) {
    const filas = pares.filter(([, v]) => v !== null && v !== undefined && v !== '');
    if (!filas.length) {
      this.parrafo('Sin información registrada.', { color: APAGADO, estilo: 'italic' });
      return;
    }
    const anchoEt = 52;
    for (const [k, v] of filas) {
      this.doc.setFont('helvetica', 'normal').setFontSize(9);
      const lineas = this.doc.splitTextToSize(String(v), this.util - anchoEt - 4);
      const altura = Math.max(4.6, lineas.length * 4.3 + 1.2);
      this.espacio(altura + 1);
      this.doc.setTextColor(...APAGADO);
      this.doc.text(this.doc.splitTextToSize(k, anchoEt - 3), this.izq, this.y);
      this.doc.setTextColor(...TINTA);
      this.doc.text(lineas, this.izq + anchoEt, this.y);
      this.y += altura;
      this.doc.setDrawColor(237, 241, 240).setLineWidth(0.2);
      this.doc.line(this.izq, this.y - 1.6, this.der, this.y - 1.6);
    }
    this.y += 2;
  }

  tabla(cabeceras, filas) {
    if (!filas.length) {
      this.parrafo('Sin datos.', { color: APAGADO, estilo: 'italic' });
      return;
    }
    if (this.doc.autoTable) {
      this.doc.autoTable({
        head: [cabeceras], body: filas, startY: this.y,
        margin: { left: this.izq, right: 16, top: this.arriba, bottom: this.alto - this.abajo },
        theme: 'plain',
        styles: { fontSize: 8.5, cellPadding: 2.2, textColor: TINTA, lineColor: BORDE, lineWidth: 0.1 },
        headStyles: { fillColor: [242, 245, 244], textColor: APAGADO, fontStyle: 'bold' },
      });
      this.y = this.doc.lastAutoTable.finalY + 5;
      return;
    }
    // Respaldo si el plugin de tablas no cargó
    for (const fila of filas) this.parrafo(fila.join(' · '), { tam: 8.5 });
  }

  chips(textos) {
    const lista = textos.filter(Boolean);
    if (!lista.length) return;
    this.espacio(6);
    this.doc.setFont('helvetica', 'normal').setFontSize(8);
    let x = this.izq;
    for (const t of lista) {
      const ancho = this.doc.getTextWidth(t) + 5;
      if (x + ancho > this.der) { this.y += 5.5; x = this.izq; this.espacio(6); }
      this.doc.setFillColor(238, 243, 241);
      this.doc.roundedRect(x, this.y - 3.2, ancho, 4.8, 2.4, 2.4, 'F');
      this.doc.setTextColor(...VERDE);
      this.doc.text(t, x + 2.5, this.y);
      x += ancho + 2;
    }
    this.y += 6;
  }

  /** Gráfico de ánimo, dibujado con primitivas del propio PDF. */
  grafico(serie) {
    if (serie.length < 2) return;
    const alto = 34, ancho = Math.min(120, this.util);
    this.espacio(alto + 6);
    const x0 = this.izq, y0 = this.y, y1 = this.y + alto;
    this.doc.setDrawColor(...BORDE).setLineWidth(0.2);
    for (const v of [1, 5, 10]) {
      const y = y1 - ((v - 1) / 9) * alto;
      this.doc.line(x0, y, x0 + ancho, y);
      this.doc.setFontSize(6.5).setTextColor(...APAGADO);
      this.doc.text(String(v), x0 - 2.5, y + 1, { align: 'right' });
    }
    this.doc.setDrawColor(...VERDE).setLineWidth(0.5);
    const puntos = serie.map((c, i) => [
      x0 + (i * ancho) / (serie.length - 1),
      y1 - ((c.escalaAnimo - 1) / 9) * alto,
    ]);
    for (let i = 1; i < puntos.length; i++) {
      this.doc.line(puntos[i - 1][0], puntos[i - 1][1], puntos[i][0], puntos[i][1]);
    }
    this.doc.setFillColor(...VERDE);
    for (const [x, y] of puntos) this.doc.circle(x, y, 0.8, 'F');
    this.y = y1 + 7;
  }
}

/** Encabezado y pie repetidos, con numeración. Se pintan al final. */
function decorar(doc, { paciente, terapeuta, info }) {
  const total = doc.internal.getNumberOfPages();
  const ancho = doc.internal.pageSize.getWidth();
  const alto = doc.internal.pageSize.getHeight();
  for (let i = 1; i <= total; i++) {
    doc.setPage(i);
    doc.setFont('helvetica', 'bold').setFontSize(8).setTextColor(...VERDE);
    doc.text(info.nombre, 16, 14);
    doc.setFont('helvetica', 'normal').setTextColor(...APAGADO);
    doc.text(`${paciente.nombreCompleto} · ${paciente.documento}`, ancho - 16, 14, { align: 'right' });
    doc.setDrawColor(...BORDE).setLineWidth(0.2);
    doc.line(16, 17, ancho - 16, 17);

    doc.line(16, alto - 16, ancho - 16, alto - 16);
    doc.setFontSize(7.5).setTextColor(138, 151, 147);
    const firma = [terapeuta.firmaNombre || terapeuta.nombre,
      terapeuta.licencia ? 'Col. ' + terapeuta.licencia : null, info.contacto]
      .filter(Boolean).join(' — ');
    doc.text(firma.slice(0, 120), 16, alto - 11);
    doc.text(`Página ${i} de ${total}`, ancho - 16, alto - 11, { align: 'right' });
  }
}

/** Compone el PDF completo y devuelve el documento de jsPDF. */
function componerReporte(tipo, paciente, parametros) {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'mm', format: 'a4' });
  const L = new Lienzo(doc);
  const info = clinica();
  const terapeuta = sesion.usuario;

  const desde = parametros.desde ? new Date(parametros.desde) : null;
  const hasta = parametros.hasta ? new Date(parametros.hasta + 'T23:59:59') : null;
  const consultas = porPaciente('consultas', paciente.id)
    .filter((c) => !desde || new Date(c.fechaHora) >= desde)
    .filter((c) => !hasta || new Date(c.fechaHora) <= hasta)
    .sort((a, b) => new Date(a.fechaHora) - new Date(b.fechaHora));
  const tareas = porPaciente('tareas', paciente.id);
  const tratamientos = porPaciente('tratamientos', paciente.id);

  // --- Portada ---
  doc.setFont('helvetica', 'bold').setFontSize(17).setTextColor(...TINTA);
  doc.text(TITULOS_REPORTE[tipo], L.izq, L.y + 2);
  L.y += 9;
  L.parrafo(`${paciente.nombreCompleto} · Documento ${paciente.documento}`, { color: APAGADO });
  L.parrafo(`Generado el ${fechaLarga(new Date())} por ${terapeuta.nombre}`, { color: APAGADO });
  if (desde || hasta) {
    L.parrafo(`Periodo: ${fecha(desde)} — ${fecha(hasta)}`, { color: APAGADO });
  }
  L.salto(2);
  doc.setFillColor(242, 245, 244);
  const texto = 'Documento clínico confidencial. Contiene información sensible protegida por la normativa de protección de datos de salud. Su difusión sin consentimiento del paciente no está autorizada.';
  doc.setFont('helvetica', 'normal').setFontSize(8);
  const lineasAviso = doc.splitTextToSize(texto, L.util - 8);
  const altoAviso = lineasAviso.length * 3.6 + 5;
  doc.rect(L.izq, L.y - 1, L.util, altoAviso, 'F');
  doc.setFillColor(...VERDE);
  doc.rect(L.izq, L.y - 1, 0.8, altoAviso, 'F');
  doc.setTextColor(69, 83, 79);
  doc.text(lineasAviso, L.izq + 4, L.y + 3);
  L.y += altoAviso + 6;

  // --- Secciones según el tipo ---
  if (parametros.incluirDatosPersonales !== false) seccionPaciente(L, paciente);
  if (tipo === 'COMPLETO') {
    seccionPermiso(L, paciente);
    seccionTratamientos(L, tratamientos);
    seccionConsultas(L, consultas, true);
    seccionTareas(L, tareas);
    seccionEvolucion(L, consultas);
  }
  if (tipo === 'SESIONES') seccionConsultas(L, consultas, true);
  if (tipo === 'EVOLUCION') { seccionEvolucion(L, consultas); seccionConsultas(L, consultas, false); }
  if (tipo === 'TAREAS') seccionTareas(L, tareas);
  if (tipo === 'TRATAMIENTOS') seccionTratamientos(L, tratamientos);

  decorar(doc, { paciente, terapeuta, info });
  return doc;
}

function seccionPaciente(L, p) {
  L.titulo('Datos del paciente');
  L.datos([
    ['Nombre completo', p.nombreCompleto],
    ['Documento', p.documento],
    ['Fecha de nacimiento', `${fecha(p.fechaNacimiento)} (${edad(p.fechaNacimiento)} años)`],
    ['Género', p.genero], ['Estado civil', p.estadoCivil], ['Ocupación', p.ocupacion],
    ['Teléfono', p.telefono], ['Email', p.email], ['Dirección', p.direccion],
    ['Contacto de emergencia', [p.emergenciaNombre, p.emergenciaTelefono].filter(Boolean).join(' · ')],
    ['Estado', et(p.estado)],
    ['Primer ingreso', fecha(p.fechaPrimerIngreso)],
    ['Última sesión', fecha(p.fechaUltimaSesion)],
  ]);
  L.subtitulo('Información clínica');
  L.datos([
    ['Motivo de consulta inicial', p.motivoConsultaInicial],
    ['Antecedentes', p.antecedentes],
    ['Medicación actual', p.medicacionActual],
    ['Alergias', p.alergias],
    ['Diagnóstico preliminar', p.diagnosticoPreliminar],
  ]);
}

function seccionPermiso(L, p) {
  L.titulo('Consentimiento informado');
  const pm = p.permiso || {};
  if (pm.estado !== 'FIRMADO') {
    L.parrafo('El consentimiento informado figura como PENDIENTE de firma.', { color: [166, 106, 0] });
    return;
  }
  L.datos([
    ['Estado', 'Firmado'],
    ['Firmado por', pm.firmaNombre],
    ['Fecha de firma', fecha(pm.fechaFirma)],
    ['Versión del documento', pm.version],
  ]);
  if (pm.texto) L.parrafo(pm.texto, { tam: 8.5, color: APAGADO });
}

function seccionConsultas(L, consultas, detallado) {
  L.titulo('Historial de consultas');
  if (!consultas.length) {
    L.parrafo('No hay consultas registradas en este periodo.', { color: APAGADO, estilo: 'italic' });
    return;
  }
  if (!detallado) {
    L.tabla(['Nº', 'Fecha', 'Modalidad', 'Duración', 'Estado emocional'],
      consultas.map((c) => [c.numeroSesion, fechaHora(c.fechaHora), et(c.modalidad),
        c.duracionMin + ' min', c.estadoEmocional || '—']));
    return;
  }
  consultas.forEach((c, i) => {
    if (i > 0) L.salto(2);
    L.subtitulo(`Sesión ${c.numeroSesion} · ${fechaHora(c.fechaHora)}`);
    L.chips([et(c.modalidad), `${c.duracionMin} min`, c.estadoEmocional,
      typeof c.escalaAnimo === 'number' ? `Ánimo ${c.escalaAnimo}/10` : null]);
    if (c.motivo) L.datos([['Motivo del día', c.motivo]]);
    L.parrafo('Evolución clínica', { tam: 8, color: APAGADO });
    L.notas(c.notas);
    if (c.observaciones) {
      L.parrafo('Observaciones', { tam: 8, color: APAGADO });
      L.notas(c.observaciones);
    }
    if (c.proximaCita) L.parrafo(`Próxima cita: ${fechaHora(c.proximaCita)}`, { tam: 8.5, color: APAGADO });
    L.parrafo(`Última modificación: ${fechaHora(c.actualizadoEn)}`, { tam: 7.5, color: [138, 151, 147] });
  });
}

function seccionTratamientos(L, tratamientos) {
  L.titulo('Tratamientos');
  if (!tratamientos.length) {
    L.parrafo('No hay tratamientos registrados.', { color: APAGADO, estilo: 'italic' });
    return;
  }
  for (const t of tratamientos) {
    L.subtitulo(t.nombre);
    L.chips([et(t.estado), t.enfoque, t.frecuencia]);
    L.datos([
      ['Inicio', fecha(t.fechaInicio)],
      ['Fin estimado', fecha(t.fechaFinEstimada)],
      ['Cierre', t.fechaCierre ? fecha(t.fechaCierre) : null],
    ]);
    if (t.descripcion) { L.parrafo('Enfoque', { tam: 8, color: APAGADO }); L.notas(t.descripcion); }
    if (t.notas) { L.parrafo('Notas', { tam: 8, color: APAGADO }); L.notas(t.notas); }
    L.salto(2);
  }
}

function seccionTareas(L, tareas) {
  L.titulo('Tareas asignadas');
  if (!tareas.length) {
    L.parrafo('No hay tareas asignadas.', { color: APAGADO, estilo: 'italic' });
    return;
  }
  const ahora = new Date();
  L.tabla(['Tarea', 'Asignada', 'Límite', 'Estado', 'Comentarios'],
    tareas.map((t) => {
      const vencida = t.fechaLimite && new Date(t.fechaLimite) < ahora &&
        !['COMPLETADA', 'NO_REALIZADA'].includes(t.estado);
      return [
        t.titulo,
        fecha(t.fechaAsignacion),
        t.fechaLimite ? fecha(t.fechaLimite) + (vencida ? ' (vencida)' : '') : '—',
        et(t.estado),
        t.feedbackTerapeuta || t.comentarioPaciente || '—',
      ];
    }));
}

function seccionEvolucion(L, consultas) {
  L.titulo('Evolución clínica');
  if (!consultas.length) {
    L.parrafo('Sin sesiones en el periodo.', { color: APAGADO, estilo: 'italic' });
    return;
  }
  const serie = consultas.filter((c) => typeof c.escalaAnimo === 'number');
  L.grafico(serie);
  for (const c of consultas) {
    const linea = `${fecha(c.fechaHora)} — Sesión ${c.numeroSesion}` +
      (c.estadoEmocional ? ` · ${c.estadoEmocional}` : '') +
      (typeof c.escalaAnimo === 'number' ? ` · ánimo ${c.escalaAnimo}/10` : '');
    L.parrafo(linea, { tam: 9, estilo: 'bold' });
    if (c.notas) {
      const resumen = c.notas.replace(/\n+/g, ' ').replace(/[*-]/g, '').trim();
      L.parrafo(resumen.length > 180 ? resumen.slice(0, 180) + '…' : resumen,
        { tam: 8.5, color: APAGADO, sangria: 4 });
    }
  }
}

/** Genera el PDF, lo registra y lo guarda (con el archivo si hay sitio). */
async function crearReporte(tipo, parametros) {
  if (!hayJsPdf()) throw new Error('SIN_JSPDF');
  const p = pacienteActual();
  const doc = componerReporte(tipo, p, parametros);
  const base64 = doc.output('datauristring');
  const blob = doc.output('blob');

  const slug = p.nombreCompleto.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-zA-Z0-9]+/g, '-').toLowerCase().slice(0, 40);
  const registro = {
    id: uid(), pacienteId: p.id, tipo, titulo: TITULOS_REPORTE[tipo],
    parametros: JSON.stringify(parametros),
    nombreArchivo: `${tipo.toLowerCase()}-${slug}-${paraInput(new Date())}.pdf`,
    tamano: blob.size, generadoPorId: sesion.usuario.id,
    creadoEn: new Date().toISOString(), pdf: base64, regenerable: false,
  };

  try {
    await guardar('reportes', registro);
  } catch (e) {
    if (e.message !== 'CUOTA') throw e;
    // Sin sitio para el archivo: se guarda la ficha del reporte y se regenera al pedirlo
    registro.pdf = null;
    registro.regenerable = true;
    BD.reportes = BD.reportes.filter((r) => r.id !== registro.id);
    await guardar('reportes', registro);
    nota('No cabía el PDF en el almacenamiento: se guardó la ficha del reporte y se regenerará al abrirlo.', 'ambar');
  }
  return { registro, blob };
}

/** Devuelve el blob del reporte: guardado o regenerado al vuelo. */
function blobDeReporte(reporte) {
  if (reporte.pdf) {
    const base64 = reporte.pdf.split(',')[1];
    const bytes = Uint8Array.from(atob(base64), (c) => c.charCodeAt(0));
    return new Blob([bytes], { type: 'application/pdf' });
  }
  const p = buscarId('pacientes', reporte.pacienteId);
  const doc = componerReporte(reporte.tipo, p, JSON.parse(reporte.parametros || '{}'));
  return doc.output('blob');
}
