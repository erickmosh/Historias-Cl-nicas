    .filter((c) => !filtroConsultas.hasta || new Date(c.fechaHora) <= new Date(filtroConsultas.hasta + 'T23:59:59'))
    .filter((c) => !filtroConsultas.modalidad || c.modalidad === filtroConsultas.modalidad)
    .sort((a, b) => new Date(b.fechaHora) - new Date(a.fechaHora));
}

