  descargarBlob(blob, `historias-clinicas-${paraInput(new Date())}.json`);
}

async function importar(archivo) {
  const texto = await archivo.text();
  let copia;
  try {
    copia = JSON.parse(texto);
  } catch {
    return nota('El archivo no es una copia válida.', 'granate');
  }
  if (!copia.pacientes) return nota('El archivo no contiene pacientes.', 'granate');
  if (!confirm('Restaurar sustituye todos los datos actuales. ¿Continuar?')) return;

  for (const c of COLECCIONES) {
    BD[c] = Array.isArray(copia[c]) ? copia[c] : [];
    await Almacen.persistir(c).catch(() => {});
  }
  // La sesión apunta a un objeto que ya no existe: hay que volver a entrar
  sesion.usuario = null;
  render();
  alert('Datos restaurados. Vuelve a entrar con tus credenciales.');
}

async function borrarTodo() {
  if (!confirm('Se borran todas las fichas, sesiones y reportes de este navegador. No hay vuelta atrás. ¿Seguro?')) return;
  if (!confirm('Última confirmación: ¿descargaste antes una copia de seguridad?')) return;
  await Almacen.borrarTodo();
  await sembrar();
  sesion.usuario = null;
  render();
}

// --- Delegación de eventos --------------------------------------------------

const ACCIONES = {
  ir: (el) => irA(el.dataset.vista),
  salir: () => { sesion.usuario = null; render(); },
  ficha: (el) => irA('ficha', { pacienteId: el.dataset.id, pestana: 'datos' }),
  pestana: (el) => { vista.pestana = el.dataset.p; consultaAbierta = null; render(); },
  'ir-reportes': () => { vista.pestana = 'reportes'; render(); },
  'cerrar-modal': () => cerrarModal(),

  'nuevo-paciente': () => modalPaciente(null),
  'editar-paciente': () => modalPaciente(pacienteActual()),
  archivar: async () => {
    const p = pacienteActual();
    const mensaje = p.archivado
      ? '¿Devolver esta ficha al listado activo?'
      : 'Archivar retira la ficha del listado activo. El historial se conserva íntegro y puedes recuperarla cuando quieras.';
    if (!confirm(mensaje)) return;
    p.archivado = !p.archivado;
    await guardar('pacientes', p);
    render();
  },

  'nueva-consulta': () => modalNuevaConsulta(),
  'abrir-consulta': (el) => {
    consultaAbierta = consultaAbierta === el.dataset.id ? null : el.dataset.id;
    render();
  },
  'guardar-consulta': (el) => guardarConsulta(el.dataset.id, false),
  'historial-consulta': (el) => mostrarHistorial(el.dataset.id),

  'nuevo-tratamiento': () => modalTratamiento(null),
  'editar-tratamiento': (el) => modalTratamiento(buscarId('tratamientos', el.dataset.id)),
  'estado-tratamiento': (el) => cambiarEstadoTratamiento(el.dataset.id, el.dataset.estado),

  'nueva-tarea': () => modalTarea(null),
  'editar-tarea': (el) => modalTarea(buscarId('tareas', el.dataset.id)),

  'generar-reporte': () => generarReporteDesdeFormulario(),
  'ver-reporte': (el) => abrirReporte(el.dataset.id, false),
  'descargar-reporte': (el) => abrirReporte(el.dataset.id, true),
  enviar: (el) => modalEnviar(el.dataset.id, el.dataset.canal),
  'preparar-envio': (el) => prepararEnvio(el.dataset.id, el.dataset.canal),
  'copiar-mensaje': async () => {
    const ok = await copiar($('#en-mensaje').value);
    $('#en-resultado').innerHTML = ok
      ? '<div class="aviso verde">Mensaje copiado.</div>'
      : '<div class="aviso ambar">No se pudo copiar. Selecciona el texto y cópialo a mano.</div>';
  },
  'marcar-enviado': (el) => marcarEnviado(el.dataset.id),
  reintentar: (el) => reintentarEnvio(el.dataset.id),

  exportar: () => exportar(),
  importar: () => $('#archivo-importar').click(),
  'borrar-todo': () => borrarTodo(),
  'guardar-plantilla': (el) => guardarPlantilla(el.dataset.id),
};

document.addEventListener('click', (e) => {
  const el = e.target.closest('[data-ac]');
  if (!el || el.tagName === 'SELECT') return;
  const accion = ACCIONES[el.dataset.ac];
  if (!accion) return;
  e.preventDefault();
  accion(el);
});

document.addEventListener('submit', (e) => {
  const id = e.target.id;
  if (id === 'form-login') return entrar(e);
  if (id === 'form-permiso') return guardarPermiso(e);
  if (id === 'form-clinica') return guardarClinica(e);
});

// Filtros: se aplican al escribir, sin botón de buscar
document.addEventListener('input', (e) => {
  const id = e.target.id;
  if (id === 'f-buscar') {
    filtroPacientes.buscar = e.target.value;
    clearTimeout(document._tf);
    document._tf = setTimeout(() => {
      const pos = e.target.selectionStart;
      render();
      const nuevo = $('#f-buscar');
      if (nuevo) { nuevo.focus(); nuevo.setSelectionRange(pos, pos); }
    }, 250);
  }
});

document.addEventListener('change', async (e) => {
  const id = e.target.id;
  if (id === 'f-estado') { filtroPacientes.estado = e.target.value; render(); }
  if (id === 'f-archivados') { filtroPacientes.archivados = e.target.checked; render(); }
  if (id === 'ft-estado') { filtroTareas.estado = e.target.value; render(); }
  if (id === 'ft-vencidas') { filtroTareas.vencidas = e.target.checked; render(); }
  if (id === 'ftf-estado') { filtroTareaFicha = e.target.value; render(); }
  if (id === 'fc-desde') { filtroConsultas.desde = e.target.value; render(); }
  if (id === 'fc-hasta') { filtroConsultas.hasta = e.target.value; render(); }
  if (id === 'fc-modalidad') { filtroConsultas.modalidad = e.target.value; render(); }
  if (id === 'r-tipo') { formReporte.tipo = e.target.value; render(); }
  if (id === 'archivo-importar' && e.target.files[0]) importar(e.target.files[0]);

  // Cambio rápido de estado de una tarea desde el listado
  if (e.target.dataset?.ac === 'estado-tarea') {
    const t = buscarId('tareas', e.target.dataset.id);
    const antes = { ...t };
    t.estado = e.target.value;
    await guardar('tareas', t);
    await auditar('Tarea', t.id, antes, { estado: t.estado });
    render();
  }
});

// Aviso al cerrar si hay cambios sin guardar en una consulta
window.addEventListener('beforeunload', (e) => {
  if ($('#estado-guardado')?.textContent.includes('sin guardar')) {
    e.preventDefault();
    e.returnValue = '';
  }
});

// --- Arranque ---------------------------------------------------------------

(async function iniciar() {
  await Almacen.iniciar();
  await Almacen.cargarTodo();
  if (!BD.usuarios.length) await sembrar();
  render();
})();
</script>
</body>
</html>
