// 2. Almacenamiento
//
// IndexedDB es lo que se pidió y lo que se usa cuando está disponible. Pero
// Chrome la bloquea en páginas abiertas con file://, así que hay una cascada:
// IndexedDB → localStorage → memoria. La app avisa arriba cuál está usando,
// porque el riesgo de perder datos no es el mismo en cada caso.
// ---------------------------------------------------------------------------

const COLECCIONES = ['usuarios', 'pacientes', 'consultas', 'tratamientos', 'tareas',
  'reportes', 'envios', 'auditoria', 'plantillas', 'config'];

const BD = Object.fromEntries(COLECCIONES.map((c) => [c, []]));

const Almacen = {
  modo: 'memoria', // indexeddb | localstorage | memoria
  idb: null,

  async iniciar() {
    try {
      this.idb = await this.abrirIdb();
      this.modo = 'indexeddb';
      return;
    } catch (e) {
      console.warn('IndexedDB no disponible:', e?.message || e);
    }
    try {
      localStorage.setItem('__prueba__', '1');
      localStorage.removeItem('__prueba__');
      this.modo = 'localstorage';
    } catch {
      this.modo = 'memoria';
    }
  },

  abrirIdb() {
    return new Promise((resolver, rechazar) => {
      if (!('indexedDB' in window)) return rechazar(new Error('sin indexedDB'));
      const req = indexedDB.open('historias-clinicas', 1);
      req.onupgradeneeded = () => {
        const db = req.result;
        for (const c of COLECCIONES) {
          if (!db.objectStoreNames.contains(c)) db.createObjectStore(c, { keyPath: 'id' });
        }
      };
      req.onsuccess = () => resolver(req.result);
      req.onerror = () => rechazar(req.error || new Error('error al abrir'));
      req.onblocked = () => rechazar(new Error('bloqueada por otra pestaña'));
      setTimeout(() => rechazar(new Error('tiempo agotado')), 3000);
    });
  },

  async cargarTodo() {
    if (this.modo === 'indexeddb') {
      for (const c of COLECCIONES) BD[c] = await this.leerIdb(c);
    } else if (this.modo === 'localstorage') {
      for (const c of COLECCIONES) {
        try { BD[c] = JSON.parse(localStorage.getItem('hc.' + c) || '[]'); }
        catch { BD[c] = []; }
      }
    }
  },

  leerIdb(coleccion) {
    return new Promise((resolver, rechazar) => {
      const tx = this.idb.transaction(coleccion, 'readonly');
      const req = tx.objectStore(coleccion).getAll();
      req.onsuccess = () => resolver(req.result || []);
      req.onerror = () => rechazar(req.error);
    });
  },

  /**
   * Reescribe una colección entera. Los volúmenes de un consultorio son
   * pequeños; a cambio, no hay dos caminos distintos de escritura que puedan
   * desincronizarse.
   */
  async persistir(coleccion) {
    if (this.modo === 'indexeddb') {
      await new Promise((resolver, rechazar) => {
        const tx = this.idb.transaction(coleccion, 'readwrite');
        const almacen = tx.objectStore(coleccion);
        almacen.clear();
        for (const registro of BD[coleccion]) almacen.put(registro);
        tx.oncomplete = resolver;
        tx.onerror = () => rechazar(tx.error);
        tx.onabort = () => rechazar(tx.error || new Error('transacción abortada'));
      });
      return;
    }
    if (this.modo === 'localstorage') {
      try {
        localStorage.setItem('hc.' + coleccion, JSON.stringify(BD[coleccion]));
      } catch (e) {
        // Cuota agotada: casi siempre por los PDF guardados
        throw new Error('CUOTA');
      }
    }
  },

  async borrarTodo() {
    for (const c of COLECCIONES) BD[c] = [];
    for (const c of COLECCIONES) await this.persistir(c).catch(() => {});
  },
};

/** Guarda o actualiza un registro y persiste la colección. */
async function guardar(coleccion, registro) {
  const lista = BD[coleccion];
  const i = lista.findIndex((r) => r.id === registro.id);
  registro.actualizadoEn = new Date().toISOString();
  if (i >= 0) lista[i] = registro; else lista.push(registro);
  try {
    await Almacen.persistir(coleccion);
  } catch (e) {
    if (e.message === 'CUOTA') throw e;
    console.error(e);
  }
  return registro;
}

const buscarId = (coleccion, id) => BD[coleccion].find((r) => r.id === id) || null;
const porPaciente = (coleccion, pacienteId) => BD[coleccion].filter((r) => r.pacienteId === pacienteId);

/**
 * Historial de cambios campo a campo. Es lo que permite que cualquier nota
 * sea editable siempre sin perder el rastro de qué decía antes.
 */
async function auditar(entidad, entidadId, antes, despues) {
  const filas = [];
  for (const campo of Object.keys(despues)) {
    const a = antes?.[campo] ?? null;
    const b = despues[campo] ?? null;
    if (String(a ?? '') === String(b ?? '')) continue;
    filas.push({
      id: uid(), entidad, entidadId, campo,
      valorAnterior: a === null ? null : String(a),
      valorNuevo: b === null ? null : String(b),
      usuarioId: sesion.usuario.id,
      creadoEn: new Date().toISOString(),
    });
  }
  if (!filas.length) return 0;
  BD.auditoria.push(...filas);
  await Almacen.persistir('auditoria').catch(() => {});
  return filas.length;
}
