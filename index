  if (!hayJsPdf()) {
    nota('La librería de PDF no cargó (¿sin conexión la primera vez?). Recarga la página con internet o usa la impresión del navegador.', 'granate');
    return;
  }
  try {
    const { registro, blob } = await crearReporte(formReporte.tipo, {
      desde: formReporte.desde || undefined,
      hasta: formReporte.hasta || undefined,
    });
    render();
    nota('PDF generado. Ya puedes verlo o prepararlo para enviar.');
    // Lo natural tras generar es mirarlo
    const url = URL.createObjectURL(blob);
    window.open(url, '_blank', 'noopener');
    setTimeout(() => URL.revokeObjectURL(url), 60000);
  } catch (e) {
    nota('No se pudo generar el PDF: ' + (e.message || e), 'granate');
  }
}

function abrirReporte(id, descargar) {
  const r = buscarId('reportes', id);
  try {
    const blob = blobDeReporte(r);
    if (descargar) return descargarBlob(blob, r.nombreArchivo);
    const url = URL.createObjectURL(blob);
    window.open(url, '_blank', 'noopener');
    setTimeout(() => URL.revokeObjectURL(url), 60000);
  } catch (e) {
    nota('No se pudo abrir el PDF: ' + (e.message || e), 'granate');
  }
}

