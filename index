/** Markdown mínimo para las notas: párrafos, listas, **negrita**, *cursiva*. */
function markdown(texto) {
  if (!texto) return '<p class="apagado">Sin contenido</p>';
  const enLinea = (s) => s
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/(^|[^*])\*([^*]+)\*(?!\*)/g, '$1<em>$2</em>');
  let html = '', lista = false;
  for (const linea of esc(texto).split('\n')) {
    const item = linea.match(/^\s*[-*]\s+(.*)$/);
    if (item) {
      if (!lista) { html += '<ul>'; lista = true; }
      html += `<li>${enLinea(item[1])}</li>`;
      continue;
    }
    if (lista) { html += '</ul>'; lista = false; }
    if (linea.trim()) html += `<p>${enLinea(linea)}</p>`;
  }
  return html + (lista ? '</ul>' : '');
}

/** Sustituye {{variables}} en las plantillas de mensaje. */
