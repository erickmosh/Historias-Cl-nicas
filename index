async function prepararEnvio(reporteId, canal) {
  const reporte = buscarId('reportes', reporteId);
  const destino = $('#en-destino').value.trim();
  const mensaje = $('#en-mensaje').value;
  const asunto = $('#en-asunto')?.value || reporte.titulo;

  if (!destino) {
    $('#en-resultado').innerHTML = '<div class="aviso granate">Falta el destinatario.</div>';
    return;
  }

  // 1) El PDF se descarga siempre: es lo que hay que adjuntar
  descargarBlob(blobDeReporte(reporte), reporte.nombreArchivo);

  // 2) Queda registrado como preparado; el envío real lo confirma la persona
  await guardar('envios', {
    id: uid(), reporteId, pacienteId: reporte.pacienteId, canal,
    destinatario: destino, asunto: canal === 'EMAIL' ? asunto : null, mensaje,
    estado: 'PREPARADO', error: 'Pendiente de confirmar el envío manual', intentos: 1,
    enviadoPorId: sesion.usuario.id, creadoEn: new Date().toISOString(),
  });

  $('#en-resultado').innerHTML = `<div class="aviso verde">
    PDF descargado. ${canal === 'EMAIL' ? 'Se abre tu programa de correo' : 'Se abre WhatsApp'} con el
    mensaje escrito: adjunta el archivo y envíalo. Después marca el envío como enviado en el historial.
  </div>`;

  // 3) El canal se abre con un respiro: lanzarlo a la vez que la descarga
  //    hace que algunos navegadores cancelen el archivo.
  setTimeout(() => {
    if (canal === 'EMAIL') {
      window.location.href =
        `mailto:${encodeURIComponent(destino)}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(mensaje)}`;
    } else {
      window.open(`https://wa.me/${normalizarTelefono(destino)}?text=${encodeURIComponent(mensaje)}`,
        '_blank', 'noopener');
    }
  }, 600);
}

async function marcarEnviado(envioId) {
  const e = buscarId('envios', envioId);
  e.estado = 'ENVIADO';
  e.error = null;
  await guardar('envios', e);
  render();
  nota('Envío marcado como enviado.');
}

async function reintentarEnvio(envioId) {
  const e = buscarId('envios', envioId);
  e.intentos = (e.intentos || 1) + 1;
  await guardar('envios', e);
  modalEnviar(e.reporteId, e.canal);
}
