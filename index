<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Historias clínicas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<!-- Generación de PDF en el propio navegador. Si no hay conexión la primera vez,
     la app sigue funcionando y ofrece "Imprimir a PDF" como alternativa. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
/* ---------------------------------------------------------------------------
   Paleta y tipografía
   Verde apagado sobre lienzo frío: legible durante horas, sin el azul clínico
   de manual. Serif solo en titulares, para que el nombre del paciente pese.
---------------------------------------------------------------------------- */
:root{
  --tinta:#17212b; --lienzo:#f2f5f4; --blanco:#fff;
  --verde:#2f6f62; --verde-claro:#eef3f1; --verde-oscuro:#245349;
  --ambar:#a66a00; --granate:#9b2c2c;
  --borde:#dde4e2; --apagado:#55635f;
  --r:8px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
  background:var(--lienzo); color:var(--tinta);
  font-size:14px; line-height:1.55; -webkit-font-smoothing:antialiased;
}
h1,h2,h3,.serif{font-family:"Source Serif 4",Georgia,serif;font-weight:600;margin:0}
h1{font-size:24px} h2{font-size:17px} h3{font-size:15px}
p{margin:0}
a{color:var(--verde)}
:focus-visible{outline:2px solid var(--verde);outline-offset:2px}
button{font:inherit}
[hidden]{display:none !important}

/* --- Estructura --- */
.app{display:flex;min-height:100vh;flex-direction:column}
@media(min-width:768px){.app{flex-direction:row}}
.lateral{background:var(--tinta);color:#fff;flex-shrink:0}
@media(min-width:768px){.lateral{width:232px;display:flex;flex-direction:column}}
.lateral .marca{padding:20px 20px 16px}
.lateral .marca p:first-child{font-family:"Source Serif 4",Georgia,serif;font-size:17px;font-weight:600}
.lateral .marca p:last-child{font-size:11px;color:rgba(255,255,255,.5);margin-top:2px}
.nav{display:flex;gap:4px;overflow-x:auto;padding:0 12px 12px}
@media(min-width:768px){.nav{flex-direction:column;overflow:visible}}
.nav button{
  display:flex;align-items:center;gap:10px;white-space:nowrap;width:100%;
  background:none;border:0;color:rgba(255,255,255,.7);padding:9px 12px;
  border-radius:var(--r);cursor:pointer;font-size:14px;text-align:left;
}
.nav button:hover{background:rgba(255,255,255,.1);color:#fff}
.nav button.activo{background:var(--verde);color:#fff}
.sesion{margin-top:auto;border-top:1px solid rgba(255,255,255,.1);padding:16px 20px;display:none}
@media(min-width:768px){.sesion{display:block}}
.sesion .rol{font-size:11px;color:rgba(255,255,255,.5)}
.sesion button{background:none;border:0;color:rgba(255,255,255,.6);font-size:12px;padding:0;margin-top:10px;cursor:pointer}
.sesion button:hover{color:#fff}
.principal{flex:1;min-width:0;padding:24px 16px}
@media(min-width:640px){.principal{padding:32px}}
.contenedor{max-width:1120px;margin:0 auto}
.estrecho{max-width:780px}

/* --- Tarjetas y bloques --- */
.tarjeta{background:var(--blanco);border:1px solid var(--borde);border-radius:var(--r)}
.p4{padding:16px} .p5{padding:20px}
.vacio{
  background:var(--blanco);border:1px dashed var(--borde);border-radius:var(--r);
  padding:48px 24px;text-align:center;
}
.vacio p:first-child{font-family:"Source Serif 4",Georgia,serif;font-size:17px}
.vacio p+p{color:var(--apagado);margin-top:4px;max-width:420px;margin-inline:auto}
.vacio .acciones{margin-top:16px;display:flex;justify-content:center}

/* --- Botones --- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:7px;
  border-radius:6px;padding:8px 12px;font-size:13px;font-weight:500;
  border:1px solid transparent;cursor:pointer;background:var(--verde);color:#fff;
  transition:background .12s;
}
.btn:hover{background:var(--verde-oscuro)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.sec{background:var(--blanco);color:var(--tinta);border-color:var(--borde)}
.btn.sec:hover{background:var(--lienzo)}
.btn.fan{background:none;color:var(--apagado);padding:6px 8px}
.btn.fan:hover{background:var(--lienzo);color:var(--tinta)}
.btn.peligro{background:var(--blanco);color:var(--granate);border-color:rgba(155,44,44,.3)}
.btn.peligro:hover{background:rgba(155,44,44,.06)}
.btn svg{width:15px;height:15px;flex-shrink:0}

/* --- Formularios --- */
.campo{display:block}
.campo>span.et{display:block;font-size:11px;font-weight:500;color:var(--apagado);margin-bottom:4px}
.campo>span.ayuda{display:block;font-size:11px;color:var(--apagado);margin-top:4px}
input,select,textarea{
  width:100%;border:1px solid var(--borde);background:var(--blanco);border-radius:6px;
  padding:8px 10px;font:inherit;font-size:13px;color:var(--tinta);
}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--verde);box-shadow:0 0 0 1px var(--verde)}
textarea{resize:vertical}
input[type=checkbox]{width:auto;accent-color:var(--verde)}
.rejilla{display:grid;gap:14px}
@media(min-width:640px){.rejilla.c2{grid-template-columns:1fr 1fr}.ancho{grid-column:1/-1}}
fieldset{border:0;padding:0;margin:0 0 20px}
legend{
  font-family:"Source Serif 4",Georgia,serif;font-weight:600;font-size:15px;
  width:100%;border-bottom:1px solid var(--borde);padding-bottom:6px;margin-bottom:12px;
}
.linea{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end}
.crecer{flex:1;min-width:220px}

/* --- Tablas --- */
table{width:100%;border-collapse:collapse;font-size:13px}
thead{background:var(--lienzo)}
th{text-align:left;font-weight:500;font-size:11px;color:var(--apagado);padding:9px 14px}
td{padding:11px 14px;border-top:1px solid var(--borde);vertical-align:top}
tbody tr:hover{background:rgba(242,245,244,.6)}
.enlace-fila{background:none;border:0;padding:0;font:inherit;font-weight:500;color:var(--tinta);cursor:pointer;text-align:left}
.enlace-fila:hover{color:var(--verde)}

/* --- Insignias --- */
.ins{display:inline-flex;align-items:center;border-radius:999px;padding:2px 9px;font-size:11px;font-weight:500;background:var(--lienzo);color:var(--apagado)}
.ins.verde{background:var(--verde-claro);color:var(--verde)}
.ins.ambar{background:rgba(166,106,0,.1);color:var(--ambar)}
.ins.granate{background:rgba(155,44,44,.1);color:var(--granate)}

/* --- Avisos --- */
.aviso{border-left:2px solid var(--ambar);background:rgba(166,106,0,.05);color:var(--ambar);padding:8px 12px;border-radius:4px;font-size:13px}
.aviso.verde{border-color:var(--verde);background:var(--verde-claro);color:var(--verde-oscuro)}
.aviso.granate{border-color:var(--granate);background:rgba(155,44,44,.05);color:var(--granate)}

/* --- Pestañas --- */
.pestanas{display:flex;gap:2px;overflow-x:auto;border-bottom:1px solid var(--borde)}
.pestanas button{
  background:none;border:0;border-bottom:2px solid transparent;padding:10px 12px;
  font-size:13px;font-weight:500;color:var(--apagado);cursor:pointer;white-space:nowrap;
}
.pestanas button:hover{color:var(--tinta);border-bottom-color:var(--borde)}
.pestanas button.activa{color:var(--verde);border-bottom-color:var(--verde)}
.pestanas .cont{color:var(--apagado);font-weight:400;margin-left:5px;font-size:11px}

/* --- Modal --- */
.velo{position:fixed;inset:0;background:rgba(23,33,43,.4);z-index:50;overflow-y:auto;padding:16px;display:flex;justify-content:center;align-items:flex-start}
@media(min-width:640px){.velo{padding:32px}}
.modal{background:var(--blanco);border-radius:var(--r);width:100%;max-width:720px;box-shadow:0 10px 40px rgba(23,33,43,.2)}
.modal.ancho{max-width:960px}
.modal.corto{max-width:520px}
.modal header{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;border-bottom:1px solid var(--borde);padding:16px 20px}
.modal header p{font-size:13px;color:var(--apagado);margin-top:2px}
.modal .cuerpo{padding:16px 20px}
.modal footer{display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--borde);padding:12px 20px}
.cerrar{background:none;border:0;color:var(--apagado);cursor:pointer;padding:4px;border-radius:4px;line-height:0}
.cerrar:hover{background:var(--lienzo)}

/* --- Login --- */
.login{display:grid;min-height:100vh}
@media(min-width:768px){.login{grid-template-columns:1fr minmax(0,440px)}}
.login .relato{background:var(--tinta);color:#fff;padding:56px 48px;display:none;flex-direction:column;justify-content:space-between}
@media(min-width:768px){.login .relato{display:flex}}
.login .relato h1{font-size:38px;line-height:1.15;max-width:460px}
.login .relato .sub{color:rgba(255,255,255,.6);margin-top:16px;max-width:420px}
.login .relato .pie{font-size:11px;color:rgba(255,255,255,.4)}
.login .form{display:flex;align-items:center;justify-content:center;padding:48px 24px}
.login .form form{width:100%;max-width:340px}
.login .pista{background:var(--lienzo);border-radius:6px;padding:8px 12px;font-size:11px;color:var(--apagado);margin-top:24px}

/* --- Ficha del paciente --- */
.cabecera-ficha{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;align-items:flex-start}
.metricas{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
.metrica .t{font-size:11px;color:var(--apagado)}
.metrica .v{font-family:"Source Serif 4",Georgia,serif;font-size:26px;font-weight:600;margin-top:2px}
.metrica .p{font-size:11px;color:var(--apagado);margin-top:2px}
dl.datos{margin:0;font-size:13px}
dl.datos>div{display:grid;gap:2px;padding:8px 0;border-bottom:1px solid var(--borde)}
@media(min-width:640px){dl.datos>div{grid-template-columns:200px 1fr}}
dl.datos>div:last-child{border-bottom:0}
dl.datos dt{color:var(--apagado)}
dl.datos dd{margin:0;white-space:pre-line}
dl.datos dd.sin{color:rgba(85,99,95,.6)}

/* --- Consultas --- */
.consulta-cab{display:flex;align-items:center;gap:12px;width:100%;background:none;border:0;padding:12px 16px;text-align:left;cursor:pointer}
.consulta-cab:hover{background:rgba(242,245,244,.6)}
.consulta-cab .resumen{flex:1;min-width:0}
.consulta-cab .resumen .sub{font-size:13px;color:var(--apagado);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.consulta-cab .meta{display:none;gap:8px;align-items:center;flex-shrink:0}
@media(min-width:640px){.consulta-cab .meta{display:flex}}
.editor{border-top:1px solid var(--borde);background:rgba(242,245,244,.4);padding:16px;display:grid;gap:14px}
.editor textarea.notas{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;line-height:1.6}
.estado-guardado{font-size:11px;color:var(--apagado);display:flex;align-items:center;gap:6px}
.punto{width:7px;height:7px;border-radius:50%;background:var(--verde);display:inline-block}
.punto.sucio{background:var(--ambar)}

/* --- Línea de tiempo --- */
ol.tiempo{list-style:none;margin:0;padding:0 0 0 20px;border-left:1px solid var(--borde)}
ol.tiempo li{position:relative;padding-bottom:18px}
ol.tiempo li:last-child{padding-bottom:0}
ol.tiempo .bolita{position:absolute;left:-25px;top:7px;width:9px;height:9px;border-radius:50%}
ol.tiempo .f{font-size:11px;color:var(--apagado)}
ol.tiempo .d{font-size:13px;color:var(--apagado)}

/* --- Lista de envíos --- */
ul.envios{list-style:none;margin:12px 0 0;padding:12px 0 0;border-top:1px solid var(--borde)}
ul.envios li{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid var(--borde);font-size:13px}
ul.envios li:last-child{border-bottom:0}
.err{color:var(--granate);font-size:11px;max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.fila-acciones{display:flex;flex-wrap:wrap;gap:8px}
.apagado{color:var(--apagado)}
.pequeno{font-size:11px}
.mt2{margin-top:8px}.mt3{margin-top:12px}.mt4{margin-top:16px}.mt5{margin-top:20px}.mt6{margin-top:24px}
.mb3{margin-bottom:12px}.mb4{margin-bottom:16px}
.entre{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.fin{display:flex;justify-content:flex-end}
.pila{display:grid;gap:12px}
.chips{display:flex;flex-wrap:wrap;gap:6px;align-items:center}

/* --- Banda de estado del almacenamiento --- */
.banda{background:rgba(166,106,0,.1);color:var(--ambar);padding:8px 16px;font-size:12px;text-align:center}
.banda button{background:none;border:0;color:inherit;text-decoration:underline;cursor:pointer;font-size:12px}

@media print{.lateral,.btn{display:none}}
@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}
</style>
</head>
