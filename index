const pacienteActual = () => buscarId('pacientes', vista.pacienteId);

function resumenPaciente(p) {
  const consultas = porPaciente('consultas', p.id);
  const tareas = porPaciente('tareas', p.id);
  const completadas = tareas.filter((t) => t.estado === 'COMPLETADA').length;
  const cerradas = tareas.filter((t) => ['COMPLETADA', 'NO_REALIZADA'].includes(t.estado)).length;
  const proxima = consultas
    .filter((c) => c.proximaCita && new Date(c.proximaCita) >= new Date())
    .sort((a, b) => new Date(a.proximaCita) - new Date(b.proximaCita))[0];
  return {
    totalSesiones: consultas.length,
    ultima: consultas.map((c) => c.fechaHora).sort().pop() || null,
    adherencia: cerradas ? Math.round((completadas / cerradas) * 100) : null,
    pendientes: tareas.filter((t) => t.estado === 'PENDIENTE').length,
    tratamientosActivos: porPaciente('tratamientos', p.id).filter((t) => t.estado === 'ACTIVO').length,
    proximaCita: proxima?.proximaCita || null,
  };
}

