<script>
/* ===========================================================================
   HISTORIAS CLÍNICAS — aplicación de una sola página, sin dependencias
   de servidor. Todo ocurre en el navegador de quien la abre.

   Organización del archivo:
     1. Utilidades          2. Almacenamiento     3. Datos de ejemplo
     4. Sesión y navegación 5. Vistas             6. Ficha del paciente
     7. Reportes en PDF     8. Envíos             9. Configuración y arranque
=========================================================================== */
'use strict';

// ---------------------------------------------------------------------------
// 1. Utilidades
// ---------------------------------------------------------------------------

const $ = (sel, raiz = document) => raiz.querySelector(sel);
const $$ = (sel, raiz = document) => Array.from(raiz.querySelectorAll(sel));

/** Escapa HTML. Se usa en TODO texto que venga de un formulario. */
function esc(v) {
  if (v === null || v === undefined) return '';
  return String(v).replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

/** crypto.randomUUID no existe en contextos no seguros (algunos file://). */
function uid() {
  if (crypto?.randomUUID) return crypto.randomUUID();
  return 'id-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
}

const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio',
  'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

const dosD = (n) => String(n).padStart(2, '0');

/**
 * Convierte a Date. Una cadena "YYYY-MM-DD" la interpreta el navegador como
 * medianoche UTC, lo que en husos negativos muestra el día anterior; aquí se
 * construye como fecha local para que un 18 de marzo siga siendo el 18.
 */
function aFecha(v) {
  if (v instanceof Date) return v;
  if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)) {
    const [a, m, d] = v.split('-').map(Number);
    return new Date(a, m - 1, d);
  }
  return new Date(v);
}

function fecha(v) {
  if (!v) return '—';
  const d = aFecha(v);
  return `${dosD(d.getDate())}/${dosD(d.getMonth() + 1)}/${d.getFullYear()}`;
}
function fechaHora(v) {
  if (!v) return '—';
  const d = aFecha(v);
  return `${fecha(v)} · ${dosD(d.getHours())}:${dosD(d.getMinutes())}`;
}
function fechaLarga(v) {
  const d = aFecha(v || Date.now());
  return `${d.getDate()} de ${MESES[d.getMonth()]} de ${d.getFullYear()}`;
}
function paraInput(v) {
  if (!v) return '';
  if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)) return v;
  const d = aFecha(v);
  return `${d.getFullYear()}-${dosD(d.getMonth() + 1)}-${dosD(d.getDate())}`;
}
function paraInputHora(v) {
  if (!v) return '';
  const d = aFecha(v);
  return `${paraInput(v)}T${dosD(d.getHours())}:${dosD(d.getMinutes())}`;
}
function relativa(v) {
  if (!v) return '—';
  const seg = (Date.now() - new Date(v).getTime()) / 1000;
  if (seg < 60) return 'hace unos segundos';
  if (seg < 3600) return `hace ${Math.round(seg / 60)} min`;
  if (seg < 86400) return `hace ${Math.round(seg / 3600)} h`;
  if (seg < 2592000) return `hace ${Math.round(seg / 86400)} días`;
  return fecha(v);
}
function edad(nacimiento) {
  if (!nacimiento) return null;
  const n = aFecha(nacimiento);
  const hoy = new Date();
  let a = hoy.getFullYear() - n.getFullYear();
  const m = hoy.getMonth() - n.getMonth();
  if (m < 0 || (m === 0 && hoy.getDate() < n.getDate())) a--;
  return a;
}

const ETIQUETAS = {
  ACTIVO: 'Activo', EN_PAUSA: 'En pausa', ALTA: 'Alta', DERIVADO: 'Derivado',
  PRESENCIAL: 'Presencial', VIRTUAL: 'Virtual', TELEFONICA: 'Telefónica',
  COMPLETADO: 'Completado', SUSPENDIDO: 'Suspendido',
  PENDIENTE: 'Pendiente', EN_PROGRESO: 'En progreso', COMPLETADA: 'Completada',
  NO_REALIZADA: 'No realizada', FIRMADO: 'Firmado',
  ENVIADO: 'Enviado', FALLIDO: 'Fallido', PREPARADO: 'Preparado',
  COMPLETO: 'Completo', SESIONES: 'Sesiones', EVOLUCION: 'Evolución',
  TAREAS: 'Tareas', TRATAMIENTOS: 'Tratamientos',
  EMAIL: 'Email', WHATSAPP: 'WhatsApp',
  fechaHora: 'fecha y hora', duracionMin: 'duración', escalaAnimo: 'escala de ánimo',
  estadoEmocional: 'estado emocional', proximaCita: 'próxima cita', notas: 'notas',
  observaciones: 'observaciones', motivo: 'motivo', modalidad: 'modalidad',
};
const et = (v) => ETIQUETAS[v] || v || '—';

const tono = (estado) => ({
  ACTIVO: 'verde', FIRMADO: 'verde', COMPLETADA: 'verde', COMPLETADO: 'verde', ENVIADO: 'verde',
  PENDIENTE: 'ambar', EN_PROGRESO: 'ambar', EN_PAUSA: 'ambar', PREPARADO: 'ambar',
  FALLIDO: 'granate', NO_REALIZADA: 'granate', SUSPENDIDO: 'granate',
}[estado] || '');

const insignia = (valor, t) => `<span class="ins ${t ?? tono(valor)}">${esc(et(valor))}</span>`;

/** Iconos mínimos en SVG. Sin librería: son nueve trazos. */
const ICONOS = {
  usuarios: '<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  calendario: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  tareas: '<path d="m3 7 2 2 4-4"/><path d="m3 17 2 2 4-4"/><path d="M13 6h8M13 12h8M13 18h8"/>',
  ajustes: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.09A1.65 1.65 0 0 0 10.6 3.09V3a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',
